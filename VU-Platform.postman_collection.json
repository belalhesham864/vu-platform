    {
      "name": "💳 Plans & Payments",
      "item": [
        {
          "name": "List Plans",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/plans", "host": ["{{base_url}}"], "path": ["plans"] },
            "description": "Public endpoint — no auth required."
          }
        },
        {
          "name": "Get Plan",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/plans/1", "host": ["{{base_url}}"], "path": ["plans", "1"] }
          }
        },
        {
          "name": "Create Payment (SetupIntent)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/payments/create", "host": ["{{base_url}}"], "path": ["payments", "create"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plan_id\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "**Step 1 of 2** — Creates a Stripe SetupIntent to save a payment method.\n\nReturns `client_secret` → use with Stripe.js `confirmSetup()` on the frontend.\n\nIf plan `is_custom: true`, returns 404 (Contact Sales)."
          }
        },
        {
          "name": "Create Subscription",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/payments/subscription", "host": ["{{base_url}}"], "path": ["payments", "subscription"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plan_id\": 1,\n  \"payment_method_id\": \"pm_card_visa\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "**Step 2 of 2** — Creates the Stripe Subscription.\n\nIf `requires_action: true` → frontend must complete 3D Secure using the returned `client_secret`.\n\nSubscription is activated via Stripe Webhook (`invoice.payment_succeeded`)."
          }
        },
        {
          "name": "Stripe Webhook",
          "request": {
            "method": "POST",
            "header": [{ "key": "Stripe-Signature", "value": "t=...,v1=..." }],
            "url": { "raw": "{{base_url}}/stripe/webhook", "host": ["{{base_url}}"], "path": ["stripe", "webhook"] },
            "body": {
              "mode": "raw",
              "raw": "{ \"type\": \"invoice.payment_succeeded\", \"data\": { \"object\": {} } }",
              "options": { "raw": { "language": "json" } }
            },
            "description": "**Internal — called by Stripe only.**\n\nHandled events:\n- `invoice.payment_succeeded` → activate subscription\n- `invoice.payment_failed` → mark as failed\n- `customer.subscription.updated` → sync status\n- `customer.subscription.deleted` → cancel subscription"
          }
        }
      ]
    },

