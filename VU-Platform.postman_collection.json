{
  "info": {
    "name": "VU-Platform API",
    "_postman_id": "vu-platform-api-collection",
    "description": "Complete API collection for VU-Platform — HR & Recruitment SaaS built with Laravel.\n\n## Setup\n1. Set `base_url` variable to your API URL (e.g. `http://localhost:8000/api`)\n2. After login, the `token` variable is auto-set\n3. Use the **Auth** folder first to register/login",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api", "type": "string" },
    { "key": "token",    "value": "",                           "type": "string" }
  ],
  "item": [

    {
      "name": "🔑 Auth",
      "item": [
        {
          "name": "Register Company",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{base_url}}/register", "host": ["{{base_url}}"], "path": ["register"] },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "company_name", "value": "Acme Corp",             "type": "text" },
                { "key": "industry",     "value": "Technology",            "type": "text" },
                { "key": "location",     "value": "Cairo, Egypt",          "type": "text" },
                { "key": "about",        "value": "We build great things", "type": "text" },
                { "key": "phone",        "value": "+201000000000",         "type": "text" },
                { "key": "website",      "value": "https://acme.com",      "type": "text" },
                { "key": "company_size", "value": "50-100",                "type": "text" },
                { "key": "logo",         "src":   "",                      "type": "file" },
                { "key": "name",         "value": "Ahmed Ali",             "type": "text" },
                { "key": "email",        "value": "ahmed@acme.com",        "type": "text" },
                { "key": "password",              "value": "Password1", "type": "text" },
                { "key": "password_confirmation", "value": "Password1", "type": "text" }
              ]
            },
            "description": "Register a new company. Auto-creates an Owner account and sends email OTP.\n\n**Password rules:** min 8 chars, letters, mixed case, numbers"
          },
          "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 201) { const r = pm.response.json(); pm.collectionVariables.set('token', r.token || r.data?.token || ''); }"], "type": "text/javascript" } }]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{base_url}}/login", "host": ["{{base_url}}"], "path": ["login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ahmed@acme.com\",\n  \"password\": \"Password1\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Login and receive JWT token. Token is auto-saved to collection variable."
          },
          "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 200) { const r = pm.response.json(); pm.collectionVariables.set('token', r.data?.token || r.token || ''); }"], "type": "text/javascript" } }]
        },
        {
          "name": "Logout",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/logout", "host": ["{{base_url}}"], "path": ["logout"] },
            "description": "Invalidate the current JWT token."
          }
        },
        {
          "name": "Verify Email (OTP)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/email/verifay", "host": ["{{base_url}}"], "path": ["email", "verifay"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otp\": \"12345\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/email/verifay/sendotp", "host": ["{{base_url}}"], "path": ["email", "verifay", "sendotp"] },
            "description": "Throttled: limited resend attempts."
          }
        },
        {
          "name": "Forget Password",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{base_url}}/forget-Password", "host": ["{{base_url}}"], "path": ["forget-Password"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ahmed@acme.com\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Sends a 5-digit numeric OTP to the email."
          }
        },
        {
          "name": "Check OTP",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{base_url}}/check-Otp", "host": ["{{base_url}}"], "path": ["check-Otp"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ahmed@acme.com\",\n  \"token\": \"12345\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{base_url}}/reset-password", "host": ["{{base_url}}"], "path": ["reset-password"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ahmed@acme.com\",\n  \"token\": \"RESET_TOKEN_HERE\",\n  \"password\": \"NewPassword1\",\n  \"password_confirmation\": \"NewPassword1\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },

