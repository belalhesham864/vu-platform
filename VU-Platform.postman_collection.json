    {
      "name": "📝 Applications",
      "item": [
        {
          "name": "List Applications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/applications",
              "host": ["{{base_url}}"], "path": ["applications"],
              "query": [
